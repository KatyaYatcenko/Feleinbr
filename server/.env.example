# Ключ ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ключ Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ключ для OpenRouter (безкоштовний тариф) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Будь-яка безкоштовна модель з openrouter.ai/models (фільтр "free")
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free

# Ключі текстових (без фото) провайдерів — необов'язково
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Довільний секрет для підпису токенів входу — просто вигадай довгий рядок
JWT_SECRET=some_random_secret_key_12345

PORT=3001

# Шлях до постійного диска (наприклад "/var/data" на Render Disk).
# Якщо не задано — база й фото лежать поруч із кодом і СТИРАЮТЬСЯ
# після кожного redeploy/сну сервера. Щоб персонажі й фото не зникали —
# додай платний Render Disk і вкажи сюди його точку монтування.
DATA_DIR=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=твій_gmail@gmail.com
SMTP_PASS=пароль_додатку_gmail