# Ключ ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ключ Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ключ для OpenRouter (безкоштовний тариф) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Будь-яка безкоштовна модель з openrouter.ai/models (фільтр "free")
OPENROUTER_MODEL=google/gemini-3.6-flash-lite:free

# Ключі текстових (без фото) провайдерів — необов'язково
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Довільний секрет для підпису токенів входу — просто вигадай довгий рядок
JWT_SECRET=some_random_secret_key_12345

PORT=3001

# SUPABASE (безкоштовна ПОСТІЙНА база даних + сховище фото)
# Рекомендований варіант — дані НЕ стираються ні при redeploy, ні при
# засинанні Render. Створи проєкт на supabase.com (безкоштовно, без картки).

# Project Settings → Database → Connection string → "URI" (режим "Transaction pooler")
DATABASE_URL=

# Project Settings → API → Project URL
SUPABASE_URL=

# Project Settings → API → service_role secret (НЕ anon key!)
SUPABASE_SERVICE_ROLE_KEY=

# Назва бакета в Storage, який треба створити й зробити Public. За
# замовчуванням очікується назва "uploads".
SUPABASE_STORAGE_BUCKET=uploads

# ==== Без Supabase (запасний варіант) ====
# Шлях до постійного диска (наприклад "/var/data" на платному Render Disk).
# Якщо не задано НІ це, НІ DATABASE_URL вище — база й фото лежать поруч із
# кодом і СТИРАЮТЬСЯ після кожного redeploy/сну сервера.
DATA_DIR=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=твій_gmail@gmail.com
SMTP_PASS=пароль_додатку_gmail